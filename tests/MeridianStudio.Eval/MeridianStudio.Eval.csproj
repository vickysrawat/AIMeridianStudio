<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MeridianStudio.Eval</RootNamespace>
    <AssemblyName>MeridianStudio.Eval</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Golden-set briefs travel with the binary so the harness is self-contained. -->
    <Content Include="briefs.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
