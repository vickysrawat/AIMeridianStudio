{
  "name": "meridian-studio-validator",
  "version": "1.0.0",
  "description": "Browserless validate-and-repair sidecar for Mermaid diagrams and documents (deterministic rule catalog).",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "jsdom": "^25.0.1",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.6.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
