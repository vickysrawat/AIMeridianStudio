{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },
  "Auth": {
    "Enabled": true,
    "DevTenantId": "default",
    "Jwt": {
      "Authority": "",
      "Audience": "",
      "RequireHttpsMetadata": true
    }
  },
  "Persistence": {
    "Path": "artifacts",
    "RetentionDays": 0,
    "RetentionSweepHours": 24
  },
  "Validator": {
    "Enabled": false,
    "BaseUrl": "http://localhost:5177",
    "Mode": "sync-deterministic",
    "TimeoutMs": 500,
    "LlmRepairEnabled": false
  },
  "Routing": {
    "Profiles": {
      "diagram-repair": "cost-optimized"
    }
  },
  "LLM": {
    "Gemini": { "ApiKey": "", "Model": "gemini-2.5-flash" },
    "Groq":   { "ApiKey": "", "Model": "llama-3.3-70b-versatile" },
    "Claude": { "ApiKey": "", "Model": "claude-sonnet-4-6" }
  },
  "Cache": {
    "DiskCachePath":   "cache",
    "DefaultTtlHours": 1,
    "Research":  { "TtlHours": 1  },
    "Blueprint": { "TtlHours": 24 },
    "Task":      { "TtlHours": 24 },
    "Document":  { "TtlHours": 24 },
    "Prompt":    { "TtlHours": 24 },
    "Domains":   { "TtlHours": 24 }
  }
}
