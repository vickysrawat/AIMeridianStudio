{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "MeridianStudio": "Debug"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:3000", "http://localhost:5173" ]
  },
  "Auth": {
    "Enabled": false,
    "DevTenantId": "local-dev"
  },
  "Persistence": {
    "Path": "artifacts",
    "RetentionDays": 0
  },
  "LLM": {
    "Gemini": { "ApiKey": "", "Model": "gemini-2.5-flash" },
    "Groq":   { "ApiKey": "", "Model": "llama-3.3-70b-versatile" },
    "Claude": { "ApiKey": "", "Model": "claude-sonnet-4-6" }
  },
  "WebSearch": {
    "Tavily": { "ApiKey": "" },
    "Serper": { "ApiKey": "" },
    "CacheTtlMinutes": 60,
    "MaxResultsPerQuery": 10,
    "DaysBack": 90
  },
  "Cache": {
    "DiskCachePath":   "cache",
    "DefaultTtlHours": 0.25,
    "Research":  { "TtlHours": 0.5 },
    "Blueprint": { "TtlHours": 4   },
    "Task":      { "TtlHours": 4   },
    "Document":  { "TtlHours": 4   },
    "Prompt":    { "TtlHours": 4   }
  }
}
